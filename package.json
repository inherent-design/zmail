{
  "name": "zmail",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./*"
  },
  "scripts": {
    "raw:dev": "tsx server/index.tsx",
    "raw:preview": "tsx server/index.tsx",
    "raw:test": "tsx scripts/test-runner.ts",
    "raw:e2e": "playwright test --config playwright.live.config.ts",
    "raw:fuzz": "tsx scripts/test-fuzz.ts",
    "raw:stress": "tsx scripts/test-stress.ts",
    "raw:bench:http": "tsx scripts/bench-http.ts",
    "raw:bench:sse": "tsx scripts/bench-sse.ts",
    "typecheck": "tsc --noEmit",
    "playwright:install": "pnpm exec playwright install chromium",
    "format": "biome check --write .",
    "lint": "biome check .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset:all": "tsx scripts/db-reset.ts all",
    "db:reset:messages": "tsx scripts/db-reset.ts messages",
    "db:reset:jobs": "tsx scripts/db-reset.ts jobs",
    "audit:corpus": "tsx scripts/audit-corpus.ts",
    "reextract:bad-bodies": "tsx scripts/reextract-bad-bodies.ts",
    "reextract:parse-errors": "tsx scripts/reextract-parse-errors.ts",
    "finance:import": "tsx scripts/import-finance-artifact.ts",
    "finance:export": "tsx scripts/export-finance-beancount.ts",
    "classify:migrate-finance-v3": "tsx scripts/classify-migrate-finance-v3.ts",
    "pi:connect": "tsx scripts/pi-connect-subscription.ts",
    "obs:up": "docker compose -f ops/observability/docker-compose.yml up",
    "obs:down": "docker compose -f ops/observability/docker-compose.yml down",
    "obs:logs": "docker compose -f ops/observability/docker-compose.yml logs -f",
    "worker:drain": "tsx scripts/worker-drain.ts",
    "profile:cpu": "NODE_OPTIONS=--cpu-prof tsx server/index.tsx",
    "profile:heap": "NODE_OPTIONS=--heap-prof tsx server/index.tsx"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.7.6",
    "@mariozechner/pi-ai": "^0.66.1",
    "@workos-inc/node": "^8.13.0",
    "better-sqlite3": "^12.8.0",
    "echarts": "^6.0.0",
    "hono": "^4.12.14",
    "html-to-text": "^9.0.5",
    "imapflow": "^1.3.1",
    "jose": "^6.2.2",
    "kysely": "^0.28.8",
    "mailparser": "^3.9.0",
    "openai": "^6.4.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "smol-toml": "^1.6.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zrender": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "^1.54.2",
    "@types/autocannon": "^7.12.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "autocannon": "^8.0.0",
    "fast-check": "^4.6.0",
    "jsdom": "^28.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lightningcss",
      "protobufjs"
    ]
  }
}
