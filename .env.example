# Non-secret local overrides
ZMAIL_BIND_HOST=127.0.0.1
ZMAIL_BIND_PORT=56711
ZMAIL_PUBLIC_ORIGIN=http://127.0.0.1:56711
ZMAIL_BASE_PATH=/
ZMAIL_RUN_WORKER=true
ZMAIL_LOG_LEVEL=info
ZMAIL_LOG_FORMAT=json
ZMAIL_REQUEST_LOGS=true
ZMAIL_SERVER_TIMING=true
ZMAIL_METRICS_ENABLED=false
ZMAIL_METRICS_PATH=/metrics
ZMAIL_LOG_FILE=
ZMAIL_OTLP_ENABLED=false
ZMAIL_OTLP_ENDPOINT=http://127.0.0.1:4318
ZMAIL_SERVICE_INSTANCE_ID=

# Optional standard OpenTelemetry env passthrough for future trace export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=zmail
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# Alternate localhost local dev
# ZMAIL_PUBLIC_ORIGIN=http://localhost:56711

# Explicit callback overrides only if you need to bypass derived defaults
# WORKOS_REDIRECT_URI=http://127.0.0.1:56711/auth/callback
# GOOGLE_OAUTH_REDIRECT_URL=http://127.0.0.1:56711/oauth/google/callback

# Secrets are loaded locally from secrets.enc.yaml via mise.
# Do not put real secrets in .env.example.
