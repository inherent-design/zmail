{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"server/**/*",
			"public/client/**/*",
			"lib/**/*",
			"config/**/*",
			"scripts/**/*",
			"test/**/*",
			"!test/.runtime/**/*",
			"vitest.config.ts",
			"playwright.live.config.ts",
			"README.md",
			"CONTRIBUTING.md"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
